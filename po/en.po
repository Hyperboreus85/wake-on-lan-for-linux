"Verranno rimossi {count} computer, inclusi tutti gli indirizzi IP, MAC e "
"dettagli importati dalla scansione. Le impostazioni grafiche non verranno "
"modificate."
msgstr ""
"{count} computers, including all IP addresses, MAC addresses, and details "
"imported from the scan, will be removed. Visual settings will not be changed."

#: src/wol_linux/ui/main_window.py:1572
msgid "Sì, cancella tutto"
msgstr "Yes, delete everything"

#: src/wol_linux/ui/main_window.py:1584
#, python-brace-format
msgid "{count} computer cancellati"
msgstr "{count} computers deleted"

#: src/wol_linux/ui/main_window.py:1597
msgid "i computer selezionati"
msgstr "the selected computers"

#: src/wol_linux/ui/main_window.py:1608
#, python-brace-format
msgid "il gruppo {group}"
msgstr "the group {group}"

#: src/wol_linux/ui/main_window.py:1610
msgid "tutti i computer"
msgstr "all computers"

#: src/wol_linux/ui/main_window.py:1618
msgid "Conferma accensione multipla — 1/3"
msgstr "Confirm multiple wake-up — 1/3"

#: src/wol_linux/ui/main_window.py:1619
#, python-brace-format
msgid "Stai per inviare il comando Wake-on-LAN a {count} computer ({target})."
msgstr "You are about to send Wake-on-LAN to {count} computers ({target})."

#: src/wol_linux/ui/main_window.py:1625
msgid "Seconda conferma — 2/3"
msgstr "Second confirmation — 2/3"

#: src/wol_linux/ui/main_window.py:1626
msgid "Controlla che nessuno dei computer sia stato selezionato per errore."
msgstr "Check that no computer was selected by mistake."

#: src/wol_linux/ui/main_window.py:1629
msgid "Ultima conferma — 3/3"
msgstr "Final confirmation — 3/3"

#: src/wol_linux/ui/main_window.py:1631
#, python-brace-format
msgid ""
"Inviare ora {count} magic packet? Questa operazione accende i computer; non "
"li spegne."
msgstr ""
"Send {count} magic packets now? This wakes the computers; it does not shut "
"them down."

#: src/wol_linux/ui/main_window.py:1640
msgid "OK, continua"
msgstr "OK, continue"

#: src/wol_linux/ui/main_window.py:1640
msgid "Sì, sveglia"
msgstr "Yes, wake"

#: src/wol_linux/ui/main_window.py:1670
msgid "Invio parzialmente riuscito"
msgstr "Partially successful delivery"

#: src/wol_linux/ui/main_window.py:1671
#, python-brace-format
msgid "Pacchetti inviati: {sent}. Errori: {failures}."
msgstr "Packets sent: {sent}. Errors: {failures}."

